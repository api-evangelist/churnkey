                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"<string>\",\n  \"users\": [\n    {\n      \"userId\": \"<string>\",\n      \"data\": {\n        \"email\": \"<email>\",\n        \"name\": \"<string>\",\n        \"billingAdmin\": \"<boolean>\",\n        \"phone\": \"<string>\"\n      }\n    },\n    {\n      \"userId\": \"<string>\",\n      \"data\": {\n        \"email\": \"<email>\",\n        \"name\": \"<string>\",\n        \"billingAdmin\": \"<boolean>\",\n        \"phone\": \"<string>\"\n      }\n    }\n  ]\n}",
