{
  "opencollection": "1.0.0",
  "info": {
    "name": "Churnkey Billing Contacts Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-ck-api-key",
      "value": "{{x-ck-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a customer event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.churnkey.co/v1/api/events/new",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Records a single customer event for segmentation, targeting, and passive data collection."
        },
        {
          "info": {
            "name": "Create up to 100 events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.churnkey.co/v1/api/events/bulk",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Records up to 100 customer events in a single request."
        }
      ]
    }
  ],
  "bundled": true
}